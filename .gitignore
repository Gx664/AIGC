settings.json
posthog_config.json
license.key
logs/
models/
__pycache__/
build/
dist/
!/AIGC_Toolkit_Setup.exe
*.spec
# 例外：Linux / macOS 是**云端**构建（GitHub Actions），spec 必须在仓库里，
# 不然 CI 跑 pyinstaller 时找不到文件。Windows 的两个 spec 仍然不入库。
!packaging/AIGC_Toolkit_unix.spec
.build_venv/
fix_umivpn_permission.bat
telemetry_queue.json

# PyInstaller 中间产物（多目录并行打包时的临时工作目录）
build[0-9]*/
dist[0-9]*/
dist_first/
# Unix 侧打包产物（命令见 packaging/AIGC_Toolkit_unix.spec 顶部；CI 与本地都会生成）
build-unix/
dist-unix/
tools/ui_verify_*.png
app/logs/
tools/screen_*.png

# 仓库根的临时工作文件（提交消息等），不入库
# 只匹配根目录且带扩展名的文件 —— 不影响子目录里的 __init__.py
/_*.*
build_installer.bat
build_installer.ps1
run_dev.bat
publish_github.bat
sync_to_d.bat
sync_to_d.ps1
